<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.sentencemaster"
    android:versionCode="6"
    android:versionName="1.4.6">

    <!-- 检查更新需联网访问 GitHub Releases API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 本地通知（Android 13+ 运行时请求） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 打卡提醒写入系统日历 -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentenceMaster"
        tools:targetApi="34">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SentenceMaster.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SentenceMaster"
            android:windowSoftInputMode="adjustResize" />

        <!-- 每日打卡提醒：由 AlarmManager 触发 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
    </application>

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />
</manifest>
